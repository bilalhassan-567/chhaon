# Copy to .env and fill in once the corresponding account exists.
# Until then, STORAGE_BACKEND=local needs nothing below to run.

# local | firestore
STORAGE_BACKEND=local

# --- Firebase Firestore (Day 1-2 setup) ---
# Set ONE of these. FIREBASE_CREDENTIALS_JSON (the service-account key as a single
# string) takes precedence — it's what CI uses, since GitHub Actions secrets can't
# mount a file. Locally, FIREBASE_CREDENTIALS_PATH (a path to the downloaded key file)
# is usually more convenient.
FIREBASE_CREDENTIALS_PATH=
FIREBASE_CREDENTIALS_JSON=

# --- Meta WhatsApp Cloud API (Day 1-2 setup) ---
# Switched from Twilio 22 Aug 2026 — Twilio's trial (incl. WhatsApp Sandbox credit) is
# not offered in Pakistan. Meta's Cloud API is direct from Meta, not a reseller, so it
# doesn't carry that regional restriction. See docs/master-workout/PROGRESS.md.
# App ID, WhatsApp Business Account ID, and Phone Number ID are identifiers, not
# secrets — fine to note here for your own reference. Access token and app secret ARE
# secrets — never anywhere but here.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
# Arbitrary string YOU choose (not issued by Meta) — enter the same value in the
# Meta App Dashboard's Webhook configuration ("Verify token" field). Meta's webhook
# verification handshake (a GET request) checks this matches before it'll send you
# real message webhooks.
WHATSAPP_VERIFY_TOKEN=
# Graph API version the app was built against — bump only deliberately.
WHATSAPP_API_VERSION=v21.0

# --- Outbound alert tuning (Day 6) ---
# "Dangerous" apparent-temperature threshold, Celsius. Not sourced from a specific
# guideline — a placeholder to tune with domain input.
ALERT_HEAT_INDEX_THRESHOLD_C=40
# Minimum hours between two alerts for the same zone.
ALERT_COOLDOWN_HOURS=6

# --- Intake rate limiting ---
INTAKE_RATE_LIMIT_MAX_MESSAGES=20
INTAKE_RATE_LIMIT_WINDOW_MINUTES=60

# --- Web Push (secondary, WhatsApp-independent report + alert channel) ---
# Unlike every other credential above, these have no external account behind them —
# generate with `python scripts/generate_vapid_keys.py --write-env`. Public key is
# safe to expose to any browser; private key is a secret like any other.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_EMAIL=mailto:example@example.com

# --- Web report form rate limiting (per submitting IP, not per phone) ---
WEB_REPORT_RATE_LIMIT_MAX_MESSAGES=20
WEB_REPORT_RATE_LIMIT_WINDOW_MINUTES=60
